# Copy this file to .env and change the values. Never commit .env.
# Passwords are used inside connection URIs: use letters, digits, - and _ only.

# --- Airflow ---
# Windows/macOS (Docker Desktop): keep 50000.
# Linux/WSL2 with the code inside Linux: use the output of `id -u` (usually 1000).
AIRFLOW_UID=50000
# Encrypts connection passwords stored by Airflow. Generate with:
#   docker run --rm apache/airflow:3.3.2-python3.12 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# Shared by all Airflow services to sign internal tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_JWT_SECRET=change-me-to-a-long-random-string
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me

# --- Airflow metadata database (internal only) ---
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change-me
AIRFLOW_DB_NAME=airflow

# --- Data warehouse (bronze, silver, gold, audit) ---
DW_USER=dataflow
DW_PASSWORD=change-me
DW_DB=dataflow
# Port published on your machine (inside Docker the warehouse listens on 5432)
DW_HOST_PORT=5433

# --- Pipeline ---
SOURCE_URL=https://archive.ics.uci.edu/static/public/502/online+retail+ii.zip
LOG_LEVEL=INFO
