model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Servidor","BancoDeDados","dim_date","dim_product","dim_customer","dim_country","fact_sales"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table dim_date
ref table dim_product
ref table dim_customer
ref table dim_country
ref table fact_sales

